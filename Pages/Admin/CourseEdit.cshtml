@page
@model LearnHub.Pages.Admin.CourseEditModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Create course" : "Edit course";
}
<a asp-page="/Admin/Index">← Administration</a>
<h1>@ViewData["Title"]</h1>
<form method="post" class="panel editor">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>

    <label asp-for="Input.Title"></label>
    <input asp-for="Input.Title" required maxlength="100" />
    <span asp-validation-for="Input.Title" class="field-validation-error"></span>

    <label asp-for="Input.Category">Category</label>
    <div class="category-select-wrapper" style="display: flex; gap: 8px; flex-wrap: wrap;">
        <select id="category-dropdown" onchange="onCategorySelectChange(this)" style="flex: 1; min-width: 200px;">
            <option value="">-- Choose existing category --</option>
            @foreach (var cat in Model.ExistingCategories)
            {
                <option value="@cat" selected="@(Model.Input.Category == cat)">@cat</option>
            }
            <option value="__NEW__" selected="@(!string.IsNullOrEmpty(Model.Input.Category) && !Model.ExistingCategories.Contains(Model.Input.Category))">+ New / Custom category</option>
        </select>
        <input asp-for="Input.Category" id="category-text-input" required maxlength="40" placeholder="Category name" style="flex: 1; min-width: 200px;" />
    </div>
    <small class="field-hint">Select an existing category from the dropdown or type a new one.</small>
    <span asp-validation-for="Input.Category" class="field-validation-error"></span>

    <label asp-for="Input.Description"></label>
    <textarea asp-for="Input.Description" required maxlength="1000" rows="5"></textarea>
    <span asp-validation-for="Input.Description" class="field-validation-error"></span>

    <label asp-for="Input.Level"></label>
    <input asp-for="Input.Level" required maxlength="30" />
    <span asp-validation-for="Input.Level" class="field-validation-error"></span>

    <label asp-for="Input.ImagePath"></label>
    <select asp-for="Input.ImagePath">
        <option value="/images/Web_dev.jpg">Web development</option>
        <option value="/images/database.jpg">Database</option>
        <option value="/images/security.jpg">Security</option>
        <option value="/images/JS.jpg">JavaScript</option>
    </select>
    <span asp-validation-for="Input.ImagePath" class="field-validation-error"></span>

    <button style="margin-top: 14px;">Save course</button>
</form>

<script>
    function onCategorySelectChange(selectElem) {
        var inputElem = document.getElementById("category-text-input");
        if (!inputElem) return;

        if (selectElem.value === "__NEW__") {
            inputElem.value = "";
            inputElem.focus();
        } else if (selectElem.value) {
            inputElem.value = selectElem.value;
        }
    }
</script>
