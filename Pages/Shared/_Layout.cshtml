@inject IConfiguration Configuration
@{
    var path = Context.Request.Path.Value ?? "";
    var homeClass = "";
    var dashboardClass = "";
    var profileClass = "";
    var historyClass = "";
    var adminClass = "";

    if (path == "/" || path.StartsWith("/Index"))
    {
        homeClass = "active";
    }
    if (path.StartsWith("/Member/Dashboard"))
    {
        dashboardClass = "active";
    }
    if (path.StartsWith("/Member/Profile"))
    {
        profileClass = "active";
    }
    if (path.StartsWith("/Member/History"))
    {
        historyClass = "active";
    }
    if (path.StartsWith("/Admin"))
    {
        adminClass = "active";
    }

    int totalXp = 0;
    if (User.Identity?.IsAuthenticated == true && int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out int userId))
    {
        using var connection = new MySqlConnection(Configuration.GetConnectionString("LearningDb"));
        connection.Open();
        using var command = new MySqlCommand("SELECT COALESCE(SUM(score), 0) * 100 FROM quiz_attempts WHERE user_id = @u", connection);
        command.Parameters.AddWithValue("@u", userId);
        totalXp = Convert.ToInt32(command.ExecuteScalar());
    }
    int xpPerLevel = 1000;
    int level = (totalXp / xpPerLevel) + 1;
    int expInLevel = totalXp % xpPerLevel;
    int expPercent = expInLevel * 100 / xpPerLevel;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - LearnHub</title>
    <link rel="icon" href="~/images/Logo.jpg" type="image/jpeg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="header">
        <a class="brand" asp-page="/Index">
            <img src="~/images/Logo.jpg" alt="LearnHub" width="36" height="36" /> LearnHub
        </a>
        <nav>
            <a asp-page="/Index" class="@(homeClass)">Explore courses</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="user-xp-widget" title="@expInLevel / @xpPerLevel XP (Total: @totalXp XP)">
                    <span class="user-level-badge">Lv.@level</span>
                    <div class="xp-bar-track">
                        <span class="xp-bar-fill" style="width: @(expPercent)%"></span>
                    </div>
                    <span class="xp-bar-text">@expInLevel/@xpPerLevel XP</span>
                </div>
                <a asp-page="/Member/Dashboard" class="@(dashboardClass)">My learning</a>
                <a asp-page="/Member/Profile" class="@(profileClass)">My profile</a>
                <a asp-page="/Member/History" class="@(historyClass)">Quiz history</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/Admin/Index" class="@(adminClass)">Administration</a>
                }
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="quiet">Sign out</button>
                </form>
            }
            else
            {
                <a asp-page="/Account/Login">Sign in</a>
                <a class="button small" asp-page="/Account/Register">Join LearnHub</a>
            }
        </nav>
    </header>

    <main id="main" class="container">
        @if (TempData["Message"] != null)
        {
            <div class="notice">@TempData["Message"]</div>
        }
        @RenderBody()
    </main>

    <footer class="footer">
        LearnHub <span>Learn a little. Build something.</span>
        <a asp-page="/About">About this platform</a>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>