@page
@model LearnHub.Pages.Member.StudyModel
@{
    ViewData["Title"] = Model.Course.Title;
    var lessons = Model.Course.Lessons;
}

<a asp-page="/Member/Dashboard">&larr; My learning</a>
<p class="eyebrow spaced">@Model.Course.Category</p>
<h1>@Model.Course.Title</h1>
<a asp-page="/Member/Discussion" asp-route-id="@Model.Course.Id">Course discussion</a>

<div class="study">
    <aside class="panel">
        <h2>Course lessons</h2>
        <nav class="lesson-list">
            @foreach (var lesson in lessons)
            {
                <a class="lesson-link" href="#lesson-@lesson.Id">
                    @(lesson.Position). @lesson.Title @(Model.Completed.Contains(lesson.Id) ? "✓" : "")
                </a>
            }
        </nav>
        <a class="button" asp-page="/Member/Quiz" asp-route-id="@Model.Course.Id">Take the quiz</a>
    </aside>

    <div class="lesson-column">
        @for (int i = 0; i < lessons.Count; i++)
        {
            var lesson = lessons[i];
            var completed = Model.Completed.Contains(lesson.Id);

            <article id="lesson-@lesson.Id" class="panel lesson">
                <p class="eyebrow">LESSON @lesson.Position</p>
                <h2>@lesson.Title</h2>
                <div class="lesson-content">@lesson.Content</div>

                @if (!string.IsNullOrEmpty(lesson.ImagePath))
                {
                    <figure>
                        <img class="learning-diagram" src="@lesson.ImagePath"/>
                    </figure>
                }

                <partial name="_LessonVideo" model="lesson" />

                @if (Model.LessonNotes.TryGetValue(lesson.Id, out var userNote) && !string.IsNullOrWhiteSpace(userNote))
                {
                    <div class="lesson-note-box" style="margin: 14px 0; padding: 12px 16px; background: #fefce8; border: 1px solid #fde047; border-left: 4px solid #eab308; border-radius: 8px;">
                        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                            <strong style="color: #854d0e; font-size: 0.95rem;">📝 My private notes:</strong>
                            <a asp-page="/Member/Notes" asp-route-id="@Model.Course.Id" asp-route-lessonId="@lesson.Id" class="button small secondary" style="padding: 2px 8px; font-size: 0.8rem;">Edit note</a>
                        </div>
                        <p style="margin: 0; white-space: pre-wrap; color: #713f12; font-size: 0.95rem;">@userNote</p>
                    </div>
                }
                else
                {
                    <div style="margin: 12px 0;">
                        <a asp-page="/Member/Notes" asp-route-id="@Model.Course.Id" asp-route-lessonId="@lesson.Id">My private notes</a>
                    </div>
                }

                <div class="lesson-nav">
                    @if (i > 0)
                    {
                        <a href="#lesson-@lessons[i - 1].Id">&larr; Previous lesson</a>
                    }
                    @if (i + 1 < lessons.Count)
                    {
                        <a href="#lesson-@lessons[i + 1].Id">Next lesson &rarr;</a>
                    }
                </div>

                <form method="post">
                    <input type="hidden" name="id" value="@Model.Course.Id" />
                    <input type="hidden" name="lessonId" value="@lesson.Id" />
                    <input type="hidden" name="complete" value="@(completed ? "false" : "true")" />
                    <button type="submit" class="@(completed ? "secondary" : "")">
                        @(completed ? "Mark as incomplete" : "Mark as complete")
                    </button>
                </form>
            </article>
        }

        @if (lessons.Count == 0)
        {
            <p class="empty">This course does not have any lessons yet.</p>
        }
    </div>
</div>
