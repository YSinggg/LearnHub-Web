@page
@model LearnHub.Pages.Member.ResultModel
@{ ViewData["Title"] = "Quiz result"; }
@section Styles {
    <style>
        .answer-review {
            border-left: 5px solid var(--blue);
            margin: 1.5rem 0;
            transition: all 0.25s ease;
        }
        .answer-review.correct {
            border-left-color: #1f8a5b;
        }
        .answer-review.incorrect {
            border-left-color: #ae2434;
        }
        .answer-review h2 {
            font-size: 1.2rem;
        }

        /* --- Gamified Scoring Enhancements --- */
        .game-hero {
            position: relative;
            background: linear-gradient(135deg, #0d233a 0%, #173b5e 100%);
            color: #ffffff;
            border-radius: 12px;
            padding: 2rem;
            margin-bottom: 2rem;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(16, 45, 69, 0.18);
        }
        .game-hero::before {
            content: "";
            position: absolute;
            top: -50px;
            right: -50px;
            width: 220px;
            height: 220px;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.2) 0%, rgba(255, 255, 255, 0) 70%);
            border-radius: 50%;
            pointer-events: none;
        }
        .game-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .game-rank-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: rgba(255, 255, 255, 0.12);
            border: 1px solid rgba(255, 215, 0, 0.4);
            backdrop-filter: blur(8px);
            padding: 0.4rem 1rem;
            border-radius: 999px;
            font-size: 0.95rem;
            letter-spacing: 0.05em;
            color: #ffe680;
            font-weight: 700;
            text-transform: uppercase;
        }
        .game-rank-icon {
            font-size: 1.4rem;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
        }
        .xp-pill {
            background: #1f8a5b;
            color: #ffffff;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 0.25rem 0.75rem;
            border-radius: 6px;
            letter-spacing: 0.04em;
        }
        .game-stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 1rem;
            margin: 1.5rem 0;
        }
        .game-stat-card {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 8px;
            padding: 1rem;
            text-align: center;
        }
        .game-stat-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #a8c4db;
            margin-bottom: 0.25rem;
        }
        .game-stat-val {
            font-size: 2rem;
            font-weight: 800;
            line-height: 1.1;
            color: #ffffff;
        }
        .progress-meter {
            height: 10px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 999px;
            overflow: hidden;
            margin: 1rem 0;
        }
        .progress-meter-fill {
            height: 100%;
            background: linear-gradient(90deg, #38ef7d, #11998e);
            width: 0%;
            transition: width 1.2s cubic-bezier(0.22, 1, 0.36, 1);
            border-radius: 999px;
        }
        .game-actions-bar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-top: 1.5rem;
        }
        .game-btn {
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #ffffff;
            cursor: pointer;
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            transition: all 0.2s ease;
            text-decoration: none;
        }
        .game-btn:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-1px);
            color: #ffffff;
        }
        .game-btn-accent {
            background: #ffe680;
            color: #102d45;
            font-weight: 700;
            border-color: #ffd700;
        }
        .game-btn-accent:hover {
            background: #fff0a6;
            color: #102d45;
        }
        /* Filter tabs */
        .filter-nav {
            display: flex;
            gap: 0.5rem;
            margin: 1.5rem 0 0.5rem;
            flex-wrap: wrap;
        }
        .filter-btn {
            background: #ffffff;
            border: 1px solid var(--line);
            padding: 0.4rem 0.9rem;
            border-radius: 20px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--muted);
            transition: all 0.2s ease;
            text-decoration: none !important;
        }
        .filter-btn.active {
            background: var(--navy);
            color: #ffffff;
            border-color: var(--navy);
            text-decoration: none !important;
        }
        .filter-btn:hover {
            text-decoration: none !important;
        }
        .filter-btn:hover:not(.active) {
            background: var(--surface);
            color: var(--ink);
        }
        .pro-tip {
            margin-top: 0.75rem;
            padding: 0.75rem;
            background: rgba(21, 88, 214, 0.06);
            border-radius: 6px;
            border-left: 3px solid var(--blue);
            font-size: 0.92rem;
        }

        @@keyframes fall {
            0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }
        .confetti-piece {
            position: fixed;
            top: 0;
            width: 10px;
            height: 14px;
            border-radius: 2px;
            pointer-events: none;
            z-index: 9999;
            animation: fall 2.5s linear forwards;
        }
    </style>
}

<!-- Interactive Gaming Score Card -->
<section class="game-hero">
    <div class="game-header">
        <div class="game-rank-badge">
            <span class="game-rank-icon">@Model.RankBadge</span>
            <span id="rank-title">@Model.RankTitle</span>
        </div>
        <span class="xp-pill">+@Model.XpEarned XP GAINED</span>
    </div>

    <p style="margin: 0; color: #a8c4db; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase;">Knowledge Check Cleared</p>
    <h1 style="margin: 0.25rem 0 0.5rem; color: #ffffff; font-size: 1.8rem;">@Model.Attempt.CourseTitle</h1>

    <div class="progress-meter">
        <div id="meter-fill" class="progress-meter-fill" data-percent="@Model.Percent"></div>
    </div>

    <div class="game-stats-grid">
        <div class="game-stat-card">
            <div class="game-stat-label">Accuracy</div>
            <div class="game-stat-val"><span id="anim-percent">0</span>%</div>
        </div>
        <div class="game-stat-card">
            <div class="game-stat-label">Correct</div>
            <div class="game-stat-val" style="color: #4ade80;">@Model.CorrectCount</div>
        </div>
        <div class="game-stat-card">
            <div class="game-stat-label">Total Questions</div>
            <div class="game-stat-val">@Model.Attempt.Total</div>
        </div>
        <div class="game-stat-card">
            <div class="game-stat-label">XP Points</div>
            <div class="game-stat-val" style="color: #ffe680;">+@Model.XpEarned</div>
        </div>
    </div>

    <div class="game-actions-bar">
        <button type="button" class="game-btn game-btn-accent" id="btn-celebrate">
            <span>🎉</span> Celebrate Again!
        </button>
        <!-- <button type="button" class="game-btn" id="btn-sound"><span id="sound-icon">🔊</span> Victory Chime: <strong id="sound-status">ON</strong></button> -->
        <a class="game-btn" asp-page="/Member/Study" asp-route-id="@Model.Attempt.CourseId">
            Review lessons
        </a>
        <a class="game-btn" asp-page="/Member/Quiz" asp-route-id="@Model.Attempt.CourseId">
            <span>🎮</span> Retake Quiz
        </a>
        <a class="game-btn" asp-page="/Member/Dashboard">
            My learning
        </a>
    </div>
</section>

<div class="section-heading" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-top: 2rem;">
    <h2>Answer review</h2>
    <div class="filter-nav" id="filter-nav">
        <button type="button" class="filter-btn active" data-filter="all">All (@Model.Answers.Count)</button>
        <button type="button" class="filter-btn" data-filter="correct">✅ Correct (@Model.CorrectCount)</button>
        <button type="button" class="filter-btn" data-filter="incorrect">❌ Need Review (@Model.IncorrectCount)</button>
    </div>
</div>

@if (Model.Answers.Count == 0)
{
    <p>This older attempt has no saved answers.</p>
}

@foreach (var answer in Model.Answers)
{
    <article class="panel answer-review @(answer.IsCorrect ? "correct" : "incorrect")" data-status="@(answer.IsCorrect ? "correct" : "incorrect")">
        <h2>@answer.Prompt</h2>
        <p><strong>@(answer.IsCorrect ? "Correct" : "Review this topic")</strong></p>
        <p>Your answer: @answer.ChosenText</p>
        <p>Correct answer: @answer.CorrectText</p>
        @if (!string.IsNullOrWhiteSpace(answer.Explanation))
        {
            <div class="pro-tip">
                <strong>💡 Pro Tip & Explanation:</strong> @answer.Explanation
            </div>
        }
    </article>
}

<a asp-page="/Member/History">All quiz attempts</a>

@section Scripts {
<script>
// Confetti drop animation
function fireConfetti() {
  var colors = ["#ffd700", "#ff4757", "#2ed573", "#1e90ff", "#ffa502"];
  for (var i = 0; i < 40; i++) {
    var piece = document.createElement("div");
    piece.className = "confetti-piece";
    piece.style.left = (Math.random() * 100) + "vw";
    piece.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
    piece.style.animationDelay = (Math.random() * 0.8) + "s";
    piece.style.animationDuration = (Math.random() * 1.5 + 1.5) + "s";
    document.body.appendChild(piece);

    setTimeout(function() {
      piece.remove();
    }, 3000);
  }
}

// Victory sound chime (C, E, G notes)
var soundEnabled = true;

function playTone(freq, delay) {
  try {
    var ctx = new (window.AudioContext || window.webkitAudioContext)();
    var osc = ctx.createOscillator();
    osc.frequency.value = freq;
    osc.connect(ctx.destination);
    osc.start(ctx.currentTime + delay);
    osc.stop(ctx.currentTime + delay + 0.15);
  } catch (e) {}
}

function playVictoryChime() {
  if (!soundEnabled) return;
  playTone(523, 0.0);
  playTone(659, 0.1);
  playTone(784, 0.2);
}

var btnSound = document.getElementById("btn-sound");
if (btnSound != null) {
  btnSound.addEventListener("click", function() {
    soundEnabled = !soundEnabled;
    document.getElementById("sound-status").textContent = soundEnabled ? "ON" : "OFF";
    document.getElementById("sound-icon").textContent = soundEnabled ? "🔊" : "🔇";
    if (soundEnabled) playVictoryChime();
  });
}

var btnCelebrate = document.getElementById("btn-celebrate");
if (btnCelebrate != null) {
  btnCelebrate.addEventListener("click", function() {
    fireConfetti();
    playVictoryChime();
  });
}

// Animate progress bar and accuracy counter
var meter = document.getElementById("meter-fill");
var counter = document.getElementById("anim-percent");
var target = parseInt(meter.getAttribute("data-percent") || "0", 10);

setTimeout(function() {
  meter.style.width = target + "%";
}, 200);

var current = 0;
var timer = setInterval(function() {
  if (current >= target) {
    clearInterval(timer);
  } else {
    current++;
    counter.textContent = current;
  }
}, 20);

if (target >= 50) {
  fireConfetti();
  playVictoryChime();
}

// Filter answer review cards
var filterButtons = document.querySelectorAll(".filter-btn");
var answerCards = document.querySelectorAll(".answer-review");

for (var b = 0; b < filterButtons.length; b++) {
  filterButtons[b].addEventListener("click", function() {
    for (var j = 0; j < filterButtons.length; j++) {
      filterButtons[j].classList.remove("active");
    }
    this.classList.add("active");

    var filter = this.getAttribute("data-filter");
    for (var k = 0; k < answerCards.length; k++) {
      var card = answerCards[k];
      var status = card.getAttribute("data-status");
      if (filter == "all" || status == filter) {
        card.style.display = "";
      } else {
        card.style.display = "none";
      }
    }
  });
}
</script>
}
