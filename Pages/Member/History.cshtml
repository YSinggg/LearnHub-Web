@page
@model LearnHub.Pages.Member.HistoryModel
@{
    ViewData["Title"] = "Quiz history";
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0";
}

<div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 10px; margin-bottom: 12px;">
    <div>
        <p class="eyebrow" style="margin: 0;">LEARNING RECORDS</p>
        <h1 style="margin: 4px 0 0 0;">Quiz History</h1>
    </div>
    <a asp-page="/Member/Dashboard" class="button secondary small">← Back to My Learning</a>
</div>

<div id="history-container" data-user-id="@userId">
    <!-- Empty message -->
    <article id="no-attempts-panel" class="panel" style="text-align: center; padding: 40px 20px; @(Model.Attempts.Count == 0 ? "" : "display: none;")">
        <p style="font-size: 1.1rem; color: var(--muted); margin-bottom: 14px;">No quiz attempts recorded yet.</p>
        <a class="button" asp-page="/Index">Explore Courses & Take a Quiz</a>
    </article>

    <div id="history-content-wrapper" style="@(Model.Attempts.Count > 0 ? "" : "display: none;")">
        <!-- Stats summary -->
        <div class="history-summary-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 20px;">
            <div class="panel" style="background: linear-gradient(135deg, #0f172a, #1e293b); color: #ffffff; padding: 16px 20px; border-radius: 10px;">
                <span style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.8;">Completed Attempts</span>
                <div id="stat-total-attempts" style="font-size: 2rem; font-weight: 700; margin-top: 4px; color: #38bdf8;">@Model.TotalAttempts</div>
            </div>
            <div class="panel" style="background: linear-gradient(135deg, #064e3b, #047857); color: #ffffff; padding: 16px 20px; border-radius: 10px;">
                <span style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.8;">Average Accuracy</span>
                <div style="font-size: 2rem; font-weight: 700; margin-top: 4px; color: #6ee7b7;">@Model.AveragePercent%</div>
            </div>
            <div class="panel" style="background: linear-gradient(135deg, #1e1b4b, #4338ca); color: #ffffff; padding: 16px 20px; border-radius: 10px;">
                <span style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.8;">Highest Score</span>
                <div style="font-size: 2rem; font-weight: 700; margin-top: 4px; color: #fde047;">@Model.BestScorePercent%</div>
            </div>
            <div class="panel" style="background: linear-gradient(135deg, #312e81, #1e293b); color: #ffffff; padding: 16px 20px; border-radius: 10px;">
                <span style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.5px; opacity: 0.8;">Latest Activity</span>
                <div id="stat-latest-date" style="font-size: 1.15rem; font-weight: 600; margin-top: 8px; color: #e2e8f0;">
                    @(Model.Attempts.Count > 0 ? Model.Attempts[0].TakenUtc.ToString("MMM dd, yyyy") : "In-Progress")
                </div>
                <span id="stat-latest-time" style="font-size: 0.8rem; color: #94a3b8;">
                    @(Model.Attempts.Count > 0 ? Model.Attempts[0].TakenUtc.ToString("HH:mm") + " UTC" : "Check drafts below")
                </span>
            </div>
        </div>

        <!-- History records table -->
        <div class="panel" style="padding: 0; overflow: hidden; border-radius: 10px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.06);">
            <div style="padding: 14px 20px; background: #f8fafc; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                <strong style="color: var(--navy); font-size: 1.05rem;">Attempt Records</strong>
                <span id="records-subtitle" style="font-size: 0.85rem; color: var(--muted);">Includes in-progress drafts and completed tests</span>
            </div>
            <div class="table-wrap" style="margin: 0; max-height: 580px; overflow-y: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.95rem;">
                    <thead style="position: sticky; top: 0; background: #f1f5f9; z-index: 2;">
                        <tr style="border-bottom: 2px solid var(--line); text-align: left;">
                            <th style="padding: 10px 16px; width: 55px; color: var(--muted);">#</th>
                            <th style="padding: 10px 16px; color: var(--navy);">Course Title</th>
                            <th style="padding: 10px 16px; color: var(--navy); width: 220px;">Result</th>
                            <th style="padding: 10px 16px; color: var(--navy); width: 190px;">Timeline</th>
                            <th style="padding: 10px 16px; color: var(--navy); width: 180px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="history-table-body">
                        @{ int index = 1; }
                        @foreach (var attempt in Model.Attempts)
                        {
                            int pct = attempt.Total > 0 ? (attempt.Score * 100 / attempt.Total) : 0;
                            string badgeColor, badgeBg, badgeIcon, rankName;
                            if (pct == 100)
                            {
                                badgeBg = "#ecfdf5";
                                badgeColor = "#065f46";
                                badgeIcon = "🏆";
                                rankName = "S-Rank";
                            }
                            else if (pct >= 80)
                            {
                                badgeBg = "#eff6ff";
                                badgeColor = "#1e40af";
                                badgeIcon = "🌟";
                                rankName = "A-Rank";
                            }
                            else if (pct >= 50)
                            {
                                badgeBg = "#fffbeb";
                                badgeColor = "#92400e";
                                badgeIcon = "⚡";
                                rankName = "B-Rank";
                            }
                            else
                            {
                                badgeBg = "#fff1f2";
                                badgeColor = "#9f1239";
                                badgeIcon = "🎯";
                                rankName = "Review";
                            }

                            <tr style="border-bottom: 1px solid var(--line); transition: background 0.15s ease;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                                <td style="padding: 10px 16px; color: var(--muted); font-size: 0.85rem;">@index</td>
                                <td style="padding: 10px 16px;">
                                    <strong style="color: var(--navy);">@attempt.CourseTitle</strong>
                                </td>
                                <td style="padding: 10px 16px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span style="display: inline-block; padding: 2px 8px; border-radius: 9999px; background: @badgeBg; color: @badgeColor; font-size: 0.82rem; font-weight: 600;">
                                            @badgeIcon @rankName: @attempt.Score/@attempt.Total (@pct%)
                                        </span>
                                    </div>
                                    <div style="width: 110px; height: 5px; background: #e2e8f0; border-radius: 3px; overflow: hidden; margin-top: 4px;">
                                        <div style="width: @pct%; height: 100%; background: @badgeColor;"></div>
                                    </div>
                                </td>
                                <td style="padding: 10px 16px; color: var(--muted); font-size: 0.88rem; white-space: nowrap;">
                                    📅 @attempt.TakenUtc.ToString("yyyy-MM-dd")<br />
                                    ⏰ @attempt.TakenUtc.ToString("HH:mm") UTC
                                </td>
                                <td style="padding: 10px 16px; text-align: right; white-space: nowrap;">
                                    <a asp-page="/Member/Result" asp-route-id="@attempt.Id" class="button small" style="padding: 4px 10px; font-size: 0.85rem; margin-right: 6px;">Review</a>
                                    <form method="post" asp-page-handler="Delete" style="display: inline;" onsubmit="return confirm('Delete this attempt record and its saved answers?');">
                                        <input type="hidden" name="id" value="@attempt.Id" />
                                        <input type="hidden" name="confirmed" value="true" />
                                        <button type="submit" class="button small quiet danger-text" style="padding: 4px 8px; font-size: 0.85rem;" title="Delete this attempt">Delete</button>
                                    </form>
                                </td>
                            </tr>
                            index++;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var container = document.getElementById("history-container");
        if (!container) return;
        var userId = container.getAttribute("data-user-id") || "0";
        var prefix = "learnhub_quiz_draft_course_";
        var userSuffix = "_user_" + userId;

        var courseTitles = {
            @foreach (var kvp in Model.CourseTitles)
            {
                <text>@kvp.Key: "@Html.Raw(kvp.Value.Replace("\"", "\\\""))",</text>
            }
        };

        var drafts = [];
        for (var i = 0; i < localStorage.length; i++) {
            var key = localStorage.key(i);
            if (key && key.indexOf(prefix) === 0 && (key.indexOf(userSuffix) !== -1 || userId === "0")) {
                try {
                    var draft = JSON.parse(localStorage.getItem(key));
                    if (draft && draft.answers && Object.keys(draft.answers).length > 0) {
                        draft._key = key;
                        if (!draft.courseId) {
                            var match = key.match(/course_(\d+)_/);
                            if (match) draft.courseId = match[1];
                        }
                        drafts.push(draft);
                    }
                } catch (e) {}
            }
        }

        if (drafts.length > 0) {
            // Newest drafts first
            drafts.sort(function (a, b) { return (b.timestamp || 0) - (a.timestamp || 0); });

            var noAttempts = document.getElementById("no-attempts-panel");
            if (noAttempts) noAttempts.style.display = "none";
            var content = document.getElementById("history-content-wrapper");
            if (content) content.style.display = "block";

            var subtitle = document.getElementById("records-subtitle");
            if (subtitle) {
                subtitle.textContent = "Includes " + drafts.length + " in-progress quiz draft" + (drafts.length > 1 ? "s" : "") + " and completed attempts";
            }

            var tbody = document.getElementById("history-table-body");
            if (tbody) {
                drafts.forEach(function (d) {
                    var row = document.createElement("tr");
                    row.id = "draft-row-" + d.courseId;
                    row.style.borderBottom = "1px solid #fed7aa";
                    row.style.background = "#fffdf5";
                    row.style.transition = "background 0.15s ease";
                    row.onmouseover = function () { this.style.background = "#fef3c7"; };
                    row.onmouseout = function () { this.style.background = "#fffdf5"; };

                    var answered = d.answered !== undefined ? d.answered : (d.answers ? Object.keys(d.answers).length : 0);
                    var total = d.total || 5;
                    var pctProgress = total > 0 ? Math.round((answered * 100) / total) : 0;
                    var title = d.courseTitle || (courseTitles && courseTitles[d.courseId]) || ("Course #" + d.courseId);

                    var savedDate = d.savedDate || "";
                    var savedTime = d.savedTime || "";
                    if (!savedDate && d.savedAt) {
                        var parts = d.savedAt.trim().split(" ");
                        if (parts.length >= 2) {
                            savedDate = parts[0];
                            savedTime = parts.slice(1).join(" ");
                        } else {
                            savedDate = d.savedAt;
                            savedTime = "";
                        }
                    } else if (!savedDate && d.timestamp) {
                        var dt = new Date(d.timestamp);
                        savedDate = dt.toLocaleDateString();
                        savedTime = dt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
                    }

                    row.innerHTML =
                        '<td style="padding: 10px 16px;">' +
                            '<span style="display: inline-block; padding: 2px 7px; background: #fef3c7; color: #92400e; border: 1px solid #fde68a; border-radius: 4px; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.5px;">DRAFT</span>' +
                        '</td>' +
                        '<td style="padding: 10px 16px;">' +
                            '<strong style="color: var(--navy); font-size: 0.98rem;">' + escapeHtml(title) + '</strong>' +
                            '<div style="font-size: 0.78rem; color: #b45309; margin-top: 2px; font-weight: 500;">⚠️ In-progress (not submitted yet)</div>' +
                        '</td>' +
                        '<td style="padding: 10px 16px;">' +
                            '<div style="display: flex; align-items: center; gap: 6px;">' +
                                '<span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 9999px; background: #fff7ed; color: #c2410c; font-size: 0.82rem; font-weight: 700; border: 1px solid #ffedd5;">' +
                                    '⏳ Incomplete (' + answered + ' of ' + total + ' answered)' +
                                '</span>' +
                            '</div>' +
                            '<div style="font-size: 0.78rem; color: #9a3412; margin-top: 3px; font-weight: 600;">No result</div>' +
                            '<div style="width: 110px; height: 5px; background: #fed7aa; border-radius: 3px; overflow: hidden; margin-top: 4px;">' +
                                '<div style="width: ' + pctProgress + '%; height: 100%; background: #ea580c;"></div>' +
                            '</div>' +
                        '</td>' +
                        '<td style="padding: 10px 16px; color: #0f172a; font-size: 0.88rem; white-space: nowrap;">' +
                            '📅 ' + escapeHtml(savedDate) + '<br />' +
                            '⏰ ' + escapeHtml(savedTime) + ' <span style="font-size: 0.74rem; color: #92400e; font-weight: 600;">(In-progress)</span>' +
                        '</td>' +
                        '<td style="padding: 10px 16px; text-align: right; white-space: nowrap;">' +
                            '<a href="/Member/Quiz?id=' + encodeURIComponent(d.courseId) + '" class="button small" style="padding: 4px 10px; font-size: 0.85rem; margin-right: 6px; background: #d97706; color: #fff; font-weight: 600;">Resume Quiz →</a>' +
                            '<button type="button" class="button small quiet danger-text" onclick="discardQuizDraft(\'' + escapeHtml(d._key) + '\', ' + d.courseId + ')" style="padding: 4px 8px; font-size: 0.85rem;" title="Discard this incomplete draft">Discard</button>' +
                        '</td>';

                    tbody.insertBefore(row, tbody.firstChild);
                });
            }
        }
    })();

    function escapeHtml(text) {
        if (!text) return "";
        var div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
    }

    function discardQuizDraft(key, courseId) {
        if (confirm("Discard this in-progress quiz draft? Your saved choices will be removed.")) {
            localStorage.removeItem(key);
            var row = document.getElementById("draft-row-" + courseId);
            if (row) row.remove();
            var tbody = document.getElementById("history-table-body");
            if (tbody && tbody.querySelectorAll("tr").length === 0) {
                var content = document.getElementById("history-content-wrapper");
                if (content) content.style.display = "none";
                var noAttempts = document.getElementById("no-attempts-panel");
                if (noAttempts) noAttempts.style.display = "block";
            }
        }
    }
</script>
