@page
@model LearnHub.Pages.Courses.DetailsModel
@{
    ViewData["Title"] = Model.Course.Title;
}
<a asp-page="/Index">← All courses</a>
<section class="hero compact">
    <div class="intro compact">
        <p class="eyebrow">@Model.Course.Category · @Model.Course.Level</p>
        <h1>@Model.Course.Title</h1>
        <p>@Model.Course.Description</p>
    </div>
    <img class="course-art" src="@Model.Course.ImagePath"/>
</section>
<div class="split">
    <section class="panel">
        <h2>What you will learn</h2>
        <ol class="lesson-list">
            @foreach (var lesson in Model.Course.Lessons)
            {
                <li>@lesson.Title</li>
            }
        </ol>
    </section>
    <aside class="panel accent">
        <h2>Make progress today</h2>
        <p>@Model.Course.Lessons.Count lessons · @Model.Course.QuestionCount quiz questions</p>
        @if (Model.Enrolled)
        {
            <a class="button" asp-page="/Member/Study" asp-route-id="@Model.Course.Id">Continue learning</a>
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post">
                <input type="hidden" name="id" value="@Model.Course.Id" />
                <button>Enrol in this course</button>
            </form>
        }
        else
        {
            <a class="button" asp-page="/Account/Login"
               asp-route-returnUrl="@Url.Page("/Courses/Details", new { id = Model.Course.Id })">Sign in to enrol</a>
        }
    </aside>
</div>

@if (Model.UserNotes.Count > 0)
{
    <section class="panel spaced private-notes-panel" style="margin-top: 24px;">
        <div class="section-heading" style="margin-bottom: 14px;">
            <h2>📝 My Private Notes (@Model.UserNotes.Count)</h2>
            <p class="field-hint">Your saved notes for this course, available alongside your course material.</p>
        </div>
        <div class="notes-list" style="display: flex; flex-direction: column; gap: 12px;">
            @foreach (var note in Model.UserNotes)
            {
                <article class="note-item" style="border: 1px solid var(--line); border-radius: 8px; padding: 14px 18px; background: #ffffff;">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px;">
                        <strong style="color: var(--navy); font-size: 1.05rem;">📖 @note.LessonTitle</strong>
                        <small style="color: var(--muted);">@note.UpdatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</small>
                    </div>
                    <p style="white-space: pre-wrap; margin: 6px 0 10px 0; color: #2d3748;">@note.NoteText</p>
                    <a class="button secondary small" asp-page="/Member/Notes" asp-route-id="@Model.Course.Id" asp-route-lessonId="@note.LessonId">✏️ Edit note</a>
                </article>
            }
        </div>
    </section>
}

<a class="button spaced" asp-page="/Courses/Preview" asp-route-id="@Model.Course.Id">Preview the first lesson</a>
