@page
@model LearnHub.Pages.Account.LoginModel
@{ ViewData["Title"] = "Sign in"; }
<section class="auth panel">
    <p class="eyebrow">PICK UP WHERE YOU LEFT OFF</p>
    <h1>Welcome back</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly"></div>
        <input type="hidden"
               asp-for="ReturnUrl" />

        <label asp-for="Input.Email"></label>
        <input asp-for="Input.Email" autocomplete="email" required maxlength="254" />
        <span asp-validation-for="Input.Email" class="field-validation-error"></span>

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" autocomplete="current-password" required maxlength="100" />
        <span asp-validation-for="Input.Password" class="field-validation-error"></span>

        <button>Sign in</button>
    </form>
    <p>New here? <a asp-page="/Account/Register">Create an account</a></p>
</section>
